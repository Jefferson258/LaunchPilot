# Copy to config/pilot.env (gitignored) and fill in what you have.
# Nothing here is required for `build`/`qa`; each step states what it needs.
# Full secrets map: docs/SETUP.md

# --- Workspace (optional) -------------------------------------------------
# Parent folder that contains product repos.
# Default: parent directory of LaunchPilot. Uncomment to override.
# export PILOT_WORKSPACE="/path/to/your/workspace"

# --- Cursor SDK (the coding step) -----------------------------------------
# Create at https://cursor.com/dashboard/integrations
export CURSOR_API_KEY=""
# Optional: model id for the agent (default: auto)
export PILOT_MODEL="auto"

# --- Vercel (website deploys) ---------------------------------------------
# Create at https://vercel.com/account/tokens
export VERCEL_TOKEN=""
# Team slug from `vercel whoami` / deploy error hint
export VERCEL_SCOPE=""

# --- TestFlight / App Store Connect ---------------------------------------
# Not in this file. Copy and edit:
#   kits/testflight/config.example.sh → config.sh
#   kits/testflight/apps.example.sh   → apps.sh
# Put the ASC .p8 under ~/.appstoreconnect/private_keys/
# Walkthrough: docs/SETUP.md

# --- Notion (optional, status updates) ------------------------------------
# Phone intake uses intake/inbox.md by default; Notion sync is optional.
export PILOT_NOTION_ENABLED="0"

# --- Phone / remote (optional notes) --------------------------------------
# Path A (M2 / sleep-wake): ./bin/pilot remote-run <product> "<prompt>" --sleep
# Path B (M4+ Always + smart plug): docs/PHONE.md
# Docs: docs/PHONE.md , docs/shortcuts-iphone.md

# --- Notifications (optional) ---------------------------------------------
# Free push via https://ntfy.sh — subscribe on phone to the same topic name.
# export PILOT_NTFY_TOPIC="your-secret-topic-name"

# --- QA / spike automation ------------------------------------------------
# `pilot run` always fails closed on missing or failed required QA.
# PILOT_QA_STRICT is retained only for compatibility with older setups.
# export PILOT_QA_STRICT="1"
# When watch-error-spikes detects a spike, append intake job and optionally run dispatch.
# export PILOT_SPIKE_AUTO_DISPATCH="0"
# Dispatch waits briefly for another worker, then fails with a recovery hint.
# export PILOT_DISPATCH_LOCK_ATTEMPTS="3"
# export PILOT_DISPATCH_LOCK_DELAY_SEC="2"
