# Copy to supabase-connections.env (gitignored) — read-only role credentials.
# One block per product; the prefix must match env_prefix in dashboards.local.json.
EXAMPLE_HOST=aws-0-us-east-1.pooler.supabase.com
EXAMPLE_PORT=5432
EXAMPLE_DB=postgres
EXAMPLE_USER=metabase_ro.YOUR_SUPABASE_PROJECT_REF
EXAMPLE_PASSWORD=

# Full Metabase (optional)
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=
