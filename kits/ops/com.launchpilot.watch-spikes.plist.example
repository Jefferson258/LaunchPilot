<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.launchpilot.watch-spikes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/tjkade/Desktop/LaunchPilot/kits/ops/watch-error-spikes.py</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/tjkade/Desktop/LaunchPilot/jobs/alerts/watch-spikes.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tjkade/Desktop/LaunchPilot/jobs/alerts/watch-spikes.err</string>
  <key>WorkingDirectory</key>
  <string>/Users/tjkade/Desktop/LaunchPilot</string>
</dict>
</plist>
